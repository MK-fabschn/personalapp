# Kopieren nach .env und ausfüllen
POSTGRES_PASSWORD=ein-langes-zufaelliges-passwort
# Erzeugen mit: npm run hash-password -- "deinLoginPasswort"
# Im .env jedes $ verdoppeln ($$), weil docker compose $ sonst als Variable liest
APP_PASSWORD_HASH=
# Kalender-Sync mit iCloud (optional): Apple-ID und app-spezifisches Passwort von account.apple.com
ICLOUD_APPLE_ID=
ICLOUD_APP_PASSWORD=
# Garmin-Import (optional): Schlüssel aus Garmin Connect → Einstellungen → Personal API Token, Laufzeit 1 Jahr
GARMIN_API_KEY=
# Ablaufdatum des Schlüssels, z. B. 2027-11-14 (die Trainingsseite erinnert 14 Tage davor)
GARMIN_API_KEY_EXPIRES=
